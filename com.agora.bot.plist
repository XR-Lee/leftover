<?xml version="1.0" encoding="UTF-8"?>
<!-- Install: cp com.agora.bot.plist ~/Library/LaunchAgents/
     then: launchctl load ~/Library/LaunchAgents/com.agora.bot.plist
     Edit REPLACE_ME paths first. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.agora.bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_ME/.venv/bin/python</string>
    <string>-m</string><string>agora</string><string>bot</string>
  </array>
  <key>WorkingDirectory</key><string>REPLACE_ME</string>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with a bare PATH; the CLIs must be findable. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:REPLACE_ME_HOME/.local/bin</string>
    <key>AGORA_TELEGRAM_TOKEN</key><string>REPLACE_ME_TOKEN</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>REPLACE_ME_HOME/Library/Logs/agora.log</string>
  <key>StandardErrorPath</key><string>REPLACE_ME_HOME/Library/Logs/agora.err.log</string>
</dict>
</plist>
